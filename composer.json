{
    "name": "znanylekarz/assets-bundle",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcin Chylek",
            "email": "marcin@chylek.pl"
        },
        {
            "name": "Łukasz Barulski",
            "email": "tracerout@yahoo.com"
        },
        {
            "name": "Tomasz Wójcik",
            "email": "tomasz.prgtw.wojcik@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-json": "*",
        "symfony/framework-bundle": "^5.4 || ^6.4",
        "symfony/yaml": "^5.4 || ^6.4",
        "twig/twig": "^1.38 || ^2 || ^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/twig-bundle": "^5.4 || ^6.4"
    },
    "autoload": {
        "psr-4": {
            "Docplanner\\AssetsBundle\\": "AssetsBundle/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Docplanner\\AssetsBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "vendor/bin/phpunit -c phpunit.xml.dist"
        ]
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    }
}
